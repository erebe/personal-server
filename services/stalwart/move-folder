require ["fileinto", "variables", "envelope", "regex", "mailbox"];

if header :is "X-Envelope-Mismatch" "Yes" {
    fileinto :create "Junk Mail";
    stop;
}

if anyof (
    address :is :domain "from" "qovery.com",
    envelope :is "from" "no-reply@qovery.com"
) {
    fileinto "Junk Mail";
    stop;
}

# Extract the local-part (before @) from the recipient address
if address :regex "to" "^([^@]+)@.*$" {

  if string :is "${1}" "erebe" {
    fileinto :create "INBOX/_erebe";
  } else {
    set :lower "folder" "INBOX/${1}";
    fileinto :create "${folder}";
    keep;
  }

  stop;
}

