require ["fileinto", "variables", "envelope", "regex", "mailbox"];

if header :is "X-Envelope-Mismatch" "Yes" {
    fileinto "Junk Mail";
    stop;
}

if anyof (
    address :is :domain "from" "qovery.com",
    envelope :is "from" "no-reply@qovery.com"
) {
    fileinto "Junk Mail";
    stop;
}

# bouyguestelecom@erebe.eu alias: only accept mail actually coming from
# bouygues-telecom.fr, everything else is spam.
if allof (
   anyof (
       envelope :is :all "to" "bouyguestelecom@erebe.eu",
       address :is :all "to" "bouyguestelecom@erebe.eu",
       address :is :all "cc" "bouyguestelecom@erebe.eu"
   ),
   not anyof (
       address :is :domain "from" "bouygues-telecom.fr",
       address :matches :domain "from" "*.bouygues-telecom.fr",
       envelope :is :domain "from" "bouygues-telecom.fr",
       envelope :matches :domain "from" "*.bouygues-telecom.fr"
   )
) {
   fileinto "Junk Mail";
   stop;
}

# Extract the local-part (before @) from the recipient address
if address :regex "to" "^([^@]+)@.*$" {

  if string :is "${1}" "erebe" {
    fileinto :create "INBOX/_erebe";
  } else {
    set :lower "folder" "INBOX/${1}";
    fileinto :create "${folder}";
    keep;
  }

  stop;
}

