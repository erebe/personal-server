{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Where requests to services/blog come from, from the DB-IP latitude/longitude the server logs on each request span.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Instant query over [$__range]: one count per location for the whole time range. `__error__=\"\"` skips the pre-JSON plain-text lines, which otherwise fail the whole query with JSONParserErr.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "basemap": {
          "config": {
            "server": "streets",
            "showLabels": true,
            "theme": "auto"
          },
          "name": "Basemap",
          "noRepeat": false,
          "opacity": 1,
          "type": "osm-standard"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showMeasure": false,
          "showScale": false,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "showLegend": true,
              "style": {
                "color": {
                  "field": "Value",
                  "fixed": "dark-green"
                },
                "opacity": 0.6,
                "size": {
                  "field": "Value",
                  "fixed": 5,
                  "max": 30,
                  "min": 4
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                }
              }
            },
            "location": {
              "latitude": "lat",
              "longitude": "lon",
              "mode": "coords"
            },
            "name": "Requests",
            "tooltip": true,
            "type": "markers"
          }
        ],
        "tooltip": {
          "mode": "details"
        },
        "view": {
          "allLayers": true,
          "dashboardVariable": false,
          "id": "zero",
          "lat": 20,
          "lon": 0,
          "noRepeat": false,
          "zoom": 1.5
        }
      },
      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum by (lat, lon, city, country) (count_over_time({job=\"default/blog\"} |= \"latitude\" | json msg=\"fields.message\", lat=\"span.latitude\", lon=\"span.longitude\", city=\"span.city\", country=\"span.country\" | __error__=\"\" | msg=\"finished processing request\" | lat!=\"\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Requests by location",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "number",
                "targetField": "lat"
              },
              {
                "destinationType": "number",
                "targetField": "lon"
              }
            ],
            "fields": {}
          }
        }
      ],
      "type": "geomap"
    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value #A"
          }
        ]
      },
      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "-- Dashboard --"
          },
          "panelId": 1,
          "refId": "A",
          "withTransforms": true
        }
      ],
      "title": "Top locations",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "lat": true,
              "lon": true
            },
            "indexByName": {
              "Value": 2,
              "city": 1,
              "country": 0
            },
            "renameByName": {
              "Value": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Requests"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "`| json` puts every field in the expandable log details; line_format only shapes the summary. Lines from before the switch to JSON logging fail the parser and fall through to the raw line.",
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "{job=\"default/blog\"} | json | line_format `{{ if .fields_status }}{{ .fields_status }} {{ .span_method }} {{ .span_site }}{{ .span_uri }} · {{ .span_user }} {{ .span_city }} {{ .span_country }} · AS{{ .span_asn }} {{ .span_org }} · {{ .fields_latency }}{{ else if .fields_message }}{{ .fields_message }}{{ else }}{{ __line__ }}{{ end }}`",
          "maxLines": 2000,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    }
  ],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
    "logs",
    "blog"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "browser",
  "title": "blog visitors",
  "uid": "blog-geomap"
}
