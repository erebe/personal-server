[Match]
Name=ens18

[Network]
DHCP=ipv4
IPv6AcceptRA=yes
IPv6PrivacyExtensions=yes

# MTUBytes belongs in [Link]. In [Network] networkd does not know the key and
# says so on every start - "Unknown key 'MTUBytes' in section [Network],
# ignoring" - so the value was never applied. The link reached 9000 anyway
# because the RA carries it and UseMTU is set below, which is why this went
# unnoticed for a year. It is *not* what broke the LAN routes on k3s; that was
# the networkd restart, see nodes/common/tasks/networkd.yml.
[Link]
MTUBytes=9000

[IPv6AcceptRA]
# Use Router Advertisement for routing
UseAutonomousPrefix=yes
UseMTU=yes
UseDNS=yes
UseDomains=yes
UseGateway=yes
