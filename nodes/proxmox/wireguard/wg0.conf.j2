[Interface]
Address = 10.200.0.7/32, fd00:cafe::7/128
ListenPort = 51820
PrivateKey = {{ ansible_facts.PROXMOX_PRIVATE_KEY }}

[Peer]
PublicKey = {{ ansible_facts.ROUTER_PUBLIC_KEY }}
AllowedIPs = 10.200.0.0/24, fd00:cafe::/32
Endpoint = 192.168.1.1:995
PersistentKeepalive = 20

# Server (hetzner). Direct tunnel over WAN instead of hairpinning through the
# router: this /28 + /123 is everything that terminates on the server (itself
# .254, phone .253, laptop .252) and wins longest-prefix over the router
# peer's /24 + /32 above.
[Peer]
PublicKey = {{ ansible_facts.SERVER_PUBLIC_KEY }}
AllowedIPs = 10.200.0.240/28, fd00:cafe::240/123
Endpoint = erebe.eu:995
PersistentKeepalive = 20

# k3s VM, on this host: reach it over vmbr0 instead of via the router.
# The /32 + /128 win longest-prefix over the router peer's /24 + /32 above.
[Peer]
PublicKey = {{ ansible_facts.LAB_PUBLIC_KEY }}
AllowedIPs = 10.200.0.3/32, fd00:cafe::3/128
Endpoint = 192.168.1.10:51820
PersistentKeepalive = 20

# toybox VM, same host, same reasoning.
[Peer]
PublicKey = {{ ansible_facts.TOYBOX_PUBLIC_KEY }}
AllowedIPs = 10.200.0.4/32, fd00:cafe::4/128
Endpoint = 192.168.1.11:51820
PersistentKeepalive = 20

# scw (scaleway). Direct tunnel over WAN instead of relaying through the
# server. The endpoint is the scw.erebe.eu DNS name, resolved by
# wg-quick when the interface comes up. The /32 + /128 win
# longest-prefix over the server peer's /28 + /123 above.
[Peer]
PublicKey = {{ ansible_facts.SCW_PUBLIC_KEY }}
AllowedIPs = 10.200.0.251/32, fd00:cafe::251/128
Endpoint = scw.erebe.eu:995
PersistentKeepalive = 20

# dns (raspberry pi), reached over 192.168.1.0/24 instead of via the router.
# The /32 + /128 win longest-prefix over the router peer's /24 + /32 above.
[Peer]
PublicKey = {{ ansible_facts.RASPBERRY_PUBLIC_KEY }}
AllowedIPs = 10.200.0.2/32, fd00:cafe::2/128
Endpoint = 192.168.1.2:51820
PersistentKeepalive = 20
