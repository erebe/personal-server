[Unit]
Description=Daily restic backup of the nextcloud photos PVC

[Timer]
# 05:00: clear of sanoid's hourly, syncoid-backup at 00:01 and syncoid-scw at
# 03:00, so a long WAN upload does not overlap the ZFS replication window.
OnCalendar=*-*-* 05:00:00
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
