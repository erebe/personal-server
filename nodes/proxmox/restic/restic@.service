[Unit]
# Templated because the jobs differ only in source path and repository, while
# sharing five settings that were measured rather than guessed (below). Two
# copies of this file would drift. Instance name = env file = restic tag.
Description=Restic backup of %i to s3.fr1.next.ink
Documentation=man:restic(1)
# The sources are ZFS datasets, and Persistent=true fires a missed run at boot -
# before the pool is necessarily imported.
Requires=zfs.target
After=zfs.target
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Type=oneshot has no start timeout by default, so a stalled upload would stay
# "activating" forever and every later trigger would be skipped. Sized for the
# first run of the largest job (~885G of photos over the WAN).
TimeoutStartSec=24h
# Without HOME the cache is disabled outright - "unable to open cache: unable
# to locate cache directory: neither $XDG_CACHE_HOME nor $HOME are defined" -
# and every run re-fetches the index from S3 instead of reading /root/.cache.
Environment=HOME=/root
# restic prints a progress bar only on a TTY, so a service logs nothing at all
# without this. Frames per *second*, so 0.0167 is one journal line a minute.
# Undocumented in --help and the man page, but honoured: verified 0 lines
# without it, periodic lines with it. `kill -USR1 $MAINPID` prints one on demand.
Environment=RESTIC_PROGRESS_FPS=0.0167
# Per-instance: RESTIC_REPOSITORY, RESTIC_PASSWORD, RESTIC_SOURCE and the S3
# credentials, written by ansible from secrets/restic.yml. Root-only -
# RESTIC_PASSWORD is the only thing standing between this bucket's contents and
# anyone who reads the file, and sops holds the only other copy.
EnvironmentFile=/etc/restic/%i.env

# Idempotent init - `restic init` errors on an existing repository, so only run
# it when the config object is genuinely absent.
ExecStartPre=/bin/sh -c '/usr/bin/restic cat config >/dev/null 2>&1 || /usr/bin/restic init'

# -o s3.connections on every invocation, not just the backup: the default of 5
# is the single biggest throughput limit here. Measured on this host against
# this bucket - 5: 16 MB/s, 20: 64 MB/s, 32: 90 MB/s.
# --pack-size 64 costs memory rather than buying speed (at 32 connections it
# was 90 MB/s either way, but peak RSS went 1.5G -> 3.9G); it is set here
# deliberately anyway, so budget for it - RAM is this host's binding constraint
# and two instances must never run at the same time. Hence 02:00 and 05:00.
# --one-file-system: stops a stray mount under the source being pulled in.
ExecStart=/usr/bin/restic backup \
  -o s3.connections=40 \
  --pack-size 64 \
  --one-file-system \
  --tag %i \
  ${RESTIC_SOURCE}

# Retention matches template_archive on this pool (nodes/proxmox/sanoid/sanoid.conf)
# so the offsite copy does not outlive the local one by accident.
# --prune only does real work on the days forget actually drops a snapshot.
ExecStart=/usr/bin/restic forget --prune \
  -o s3.connections=40 \
  --pack-size 64 \
  --tag %i \
  --keep-daily 30 --keep-weekly 8 --keep-monthly 12

# Weekly consistency check. This unit fires daily, so the weekday guard is what
# makes it weekly - %%u is escaped because systemd would otherwise expand a bare
# %u to the user name. Last on purpose: prune is the only operation that
# rewrites the repository, so the check runs against its result.
# Structure and metadata only - `--read-data` would pull the whole repository
# back out of S3 every week. `--read-data-subset=1/52` would verify contents
# too, spread over a year.
ExecStart=/bin/sh -c '[ "$(date +%%u)" -ne 7 ] || /usr/bin/restic check -o s3.connections=40'

[Install]
WantedBy=multi-user.target
