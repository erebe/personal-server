[Unit]
Description=Daily syncoid replication from scw

[Timer]
# 03:00, not daily (=00:00): scw's sanoid runs with TZ=UTC, so its daily
# snapshot lands at 02:00 local. Pulling earlier would leave the replica's
# newest daily a day behind, as the 00:01 nvme job does. Also keeps the WAN
# transfer out of that job's slot.
OnCalendar=*-*-* 03:00:00
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
