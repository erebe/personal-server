[Interface]
Address = 10.200.0.254/32, fd00:cafe::254/128, 2001:bc8:3d8f:cafe::1/64
PrivateKey = {{ ansible_facts.SERVER_PRIVATE_KEY }}
ListenPort = 995

[Peer]
PublicKey = {{ ansible_facts.ROUTER_PUBLIC_KEY }}
AllowedIPs = 10.200.0.0/24, fd00:cafe::/32
#Endpoint = [2001:861:3886:7e00::1]:995

[Peer]
PublicKey = {{ ansible_facts.PHONE_PUBLIC_KEY }}
AllowedIPs = 10.200.0.253/32, fd00:cafe::253/128

[Peer]
PublicKey = {{ ansible_facts.LAPTOP_PUBLIC_KEY }}
AllowedIPs = 10.200.0.252/32, fd00:cafe::252/128, 2a01:4f8:c013:7b8::cafe/128

# LAN nodes behind the router (192.168.1.0/24), direct tunnels instead of being
# relayed by the router peer above. No Endpoint: they are NATed, so the server
# learns their endpoint from the handshake and they hold it open with
# PersistentKeepalive. The /32 + /128 win longest-prefix over the router
# peer's /24 + /32.
[Peer]
PublicKey = {{ ansible_facts.LAB_PUBLIC_KEY }}
AllowedIPs = 10.200.0.3/32, fd00:cafe::3/128

[Peer]
PublicKey = {{ ansible_facts.TOYBOX_PUBLIC_KEY }}
AllowedIPs = 10.200.0.4/32, fd00:cafe::4/128

[Peer]
PublicKey = {{ ansible_facts.PROXMOX_PUBLIC_KEY }}
AllowedIPs = 10.200.0.7/32, fd00:cafe::7/128
