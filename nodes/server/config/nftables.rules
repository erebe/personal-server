#!/sbin/nft -f

table inet SERVER_FIREWALL { }

flush table inet SERVER_FIREWALL

table inet SERVER_FIREWALL {

        set denylist {
              type ipv4_addr; flags dynamic, timeout; timeout 5m;
        }
        define whitelist = { 94.239.37.161/32, 10.200.0.0/16 }

        chain input {
              type filter hook input priority 0; policy drop;

              ct state invalid drop comment "early drop of invalid packets"
              ct state {established, related} accept comment "accept all connections related to connections made by us"

              # `lo` is left as iif: it cannot be renamed, removed or
              # re-created, so none of the ifindex hazards apply, and this keeps
              # the line identical to scw's.
              iif lo accept comment "accept loopback"
              iifname wg0 accept comment "accept wireguard traffic"
              iifname != "eth0" ip daddr 10.42.0.0/16  accept comment "Allow incoming kube traffic"
              iifname != "eth0" ip6 daddr fd01::/48 accept comment "Allow incoming kube traffic"

              # The rules above only cover traffic addressed to a *pod*. Anything
              # a pod sends to the node itself - the Alloy DaemonSet on :12345
              # and the kubelet on :10250, both hostNetwork - is addressed to the
              # node IP instead, arrives on the CNI bridge rather than wg0, and
              # so falls through to `policy drop`. Not currently reachable here,
              # because Prometheus runs on scw and its scrapes of this node
              # arrive over wg0; this only bites for a pod on server scraping
              # server. Kept in step with scw's rules so it does not become a
              # puzzle later.
              # Matching on the pod source range, with the WAN excluded, so the
              # internet cannot spoof its way in.
              iifname != "eth0" ip saddr 10.42.0.0/16 accept comment "Allow pods to reach host services (alloy, kubelet)"
              iifname != "eth0" ip6 saddr fd01::/48 accept comment "Allow pods to reach host services (alloy, kubelet)"

              meta l4proto icmp accept comment "Accept ICMP"
              meta l4proto ipv6-icmp accept comment "accept all ICMP types"
              udp dport 546 ip6 saddr { fc00::/7, fe80::/10, 2001:bc8:2::5:136:1 } accept comment "allow DHCPv6 client"

              tcp dport 22 accept comment "accept local SSH"

              tcp dport { 80, 443, 4443, 8084 } accept comment "accept http"
              udp dport 443 accept comment "accept http3"

              tcp dport {25, 465, 587, 993} accept comment "accept email"

              udp dport 995 accept comment "accept wireguard"

              #tcp dport 6443 accept comment "accept kubernetes"
        }

        chain nat_prerouting {
              type nat hook prerouting priority dstnat; policy accept;

              ip saddr != $whitelist tcp dport {22, 25, 587, 2222} ct state new, untracked limit rate over 5/minute add @denylist { ip saddr } comment "add to blacklist"
              ip saddr @denylist drop comment "dont allow blacklisted ip"
        }

        chain forward {
              type filter hook forward priority 0; policy drop;

              ip saddr 10.42.0.0/16 accept comment "Allow forward of kube traffic"
              ip daddr 10.42.0.0/16 accept comment "Allow forward of kube traffic"
              ip6 saddr fd01::/48 accept comment "Allow forward of kube traffic"
              ip6 daddr fd01::/48 accept comment "Allow forward of kube traffic"

              iifname wg0 accept comment "accept wireguard traffic"
              oifname wg0 accept comment "accept wireguard traffic"
        }

        chain nat_postrouting {
              type nat hook postrouting priority 0; policy accept;

              oifname "eth0" ip saddr 10.200.0.0/23 masquerade comment "Allow NATing IPv4 wireguard traffic"
              oifname "eth0" ip6 saddr fd00:cafe::/32 masquerade comment "Allow NATing IPv6 wireguard traffic"
        }

        chain output {
              type filter hook output priority 0; policy accept;
        }
}
