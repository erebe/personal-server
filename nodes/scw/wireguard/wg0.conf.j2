[Interface]
Address = 10.200.1.2/32, fd00:cafe:1::2/128
ListenPort = 995
PrivateKey = {{ ansible_facts.SCW_PRIVATE_KEY }}
# Derived in group_vars/all.yml from the 1500-byte IPv4 transport.
MTU = {{ wg_mtu }}

# Server (hetzner) is the hub of the public subnet this node sits in, and the
# default path to the whole overlay (both /24s). The peers below carve direct
# paths to the LAN side out of it.
[Peer]
PublicKey = {{ ansible_facts.SERVER_PUBLIC_KEY }}
AllowedIPs = 10.200.0.0/23, fd00:cafe::/32
Endpoint = {{ server_ipv4 }}:995
PersistentKeepalive = 20

# Direct tunnels to the LAN side, instead of being relayed by the server peer
# above. No Endpoint: they sit behind the home NAT, so scw learns their
# endpoint from the handshake and they hold it open with PersistentKeepalive.
# The /32 + /128 win longest-prefix over the server peer's /23 + /32.
#
# The router peer carries the whole LAN /24, not just the router's own address:
# it forwards traffic from every LAN spoke down this tunnel, and WireGuard
# drops a decrypted packet whose source is outside the AllowedIPs of the peer
# it arrived from. A /32 here silently blackholes styx -> scw.
[Peer]
PublicKey = {{ ansible_facts.ROUTER_PUBLIC_KEY }}
AllowedIPs = 10.200.0.0/24, fd00:cafe:0::/64

[Peer]
PublicKey = {{ ansible_facts.RASPBERRY_PUBLIC_KEY }}
AllowedIPs = 10.200.0.2/32, fd00:cafe::2/128

[Peer]
PublicKey = {{ ansible_facts.LAB_PUBLIC_KEY }}
AllowedIPs = 10.200.0.3/32, fd00:cafe::3/128

[Peer]
PublicKey = {{ ansible_facts.TOYBOX_PUBLIC_KEY }}
AllowedIPs = 10.200.0.4/32, fd00:cafe::4/128

[Peer]
PublicKey = {{ ansible_facts.PROXMOX_PUBLIC_KEY }}
AllowedIPs = 10.200.0.7/32, fd00:cafe::7/128

# styx on its wgall-scw profile, using this node as its exit to the internet.
# The same .52 is also configured on the server (styx's wgall profile); only
# one of the two is ever up, and we only care about egress, so the ambiguity
# costs nothing. Note this /32 beats the server peer's /23 above, so while
# styx is *not* connected here, scw-originated traffic to .52 dead-ends rather
# than going out to the server - harmless for an egress-only address.
[Peer]
PublicKey = {{ ansible_facts.STYX_PUBLIC_KEY }}
AllowedIPs = 10.200.1.52/32, fd00:cafe:1::52/128
